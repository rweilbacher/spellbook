<?xml version="1.0" encoding="utf-8"?>
<!--
  The draw screen's card, cut down to what survives at widget size: the brass
  rule, the spell in serif, and a footer of sigil and situation. The id on the
  root is @android:id/background so the launcher can round and clip the card to
  whatever radius the device uses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="15dp"
    android:paddingEnd="17dp"
    android:paddingTop="15dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_rule"
            android:contentDescription="@null" />

        <!--
          Autosizing rather than a size chosen in code: the spells run from four
          words to a paragraph and the widget can be any size the launcher
          allows, so the type finds its own size between 12 and 21sp.
        -->
        <TextView
            android:id="@+id/widget_spell"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="9"
            android:ellipsize="end"
            android:text="@string/widget_preview"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="21sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="11dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sigil_mark"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_tags"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/dim"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_preview_tags" />
    </LinearLayout>

</LinearLayout>
